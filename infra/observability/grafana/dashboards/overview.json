{
    "title": "Overview",
    "uid": "overview",
    "schemaVersion": 39,
    "refresh": "10s",
    "panels": [
        {
            "type": "timeseries",
            "title": "Requests / sec",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total[1m])) by (path)",
                    "legendFormat": "{{path}}"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Error rate",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
                    "legendFormat": "5xx"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "p95 latency",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p95"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Unpublished domain events",
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(domain_events_unpublished_total)",
                    "legendFormat": "unpublished"
                }
            ]
        }
    ]
}